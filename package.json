{
  "name": "polskie-slady-taszkent",
  "private": true,
  "version": "1.2.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "assets:generate:android": "npx capacitor-assets generate --android",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "npm run lint -- --quiet && npm run format:check",
    "build": "vite build",
    "build:sync:android": "npx cap sync android",
    "build:copy:android": "npx cap copy android",
    "build:debugApp:android": "cd android && ./gradlew assembleDebug",
    "build:releaseApp:android": "cd android && ./gradlew bundleRelease",
    "build:all": "npm run build && npm run build:sync:android && npm run build:copy:android && npm run build:debugApp:android && npm run build:releaseApp:android",
    "release": "node scripts/release.mjs",
    "preview": "vite preview --host",
    "map:download-sprites": "node scripts/downloadProtomapsSprites.mjs"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "keywords": [
    "Hybrid Web App",
    "SPA",
    "Svelte.js",
    "Capacitor.js"
  ],
  "author": "Dmitry Adamov",
  "license": {
    "type": "MIT",
    "url": "https://opensource.org/license/mit"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.11",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@mateothegreat/svelte5-router": "^2.16.19",
    "@protomaps/basemaps": "^5.7.2",
    "capacitor-native-settings": "^8.2.0",
    "i18next": "^26.4.2",
    "konsta": "^5.5.0",
    "maplibre-gl": "^6.12.0",
    "pmtiles": "^4.5.0",
    "swiper": "^14.3.0"
  }
}
