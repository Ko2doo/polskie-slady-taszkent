{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git -C * stash *)",
      "Bash(git restore *)",
      "Bash(git -C * restore *)",
      "Bash(git rm *)",
      "Bash(git -C * rm *)",
      "Bash(git checkout *)",
      "Bash(git -C * checkout *)",
      "Bash(git switch *)",
      "Bash(git -C * switch *)",
      "Bash(git branch *)",
      "Bash(git -C * branch *)",
      "Bash(git worktree *)",
      "Bash(git -C * worktree *)",
      "Bash(git merge *)",
      "Bash(git -C * merge *)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git tag *)",
      "Bash(git -C * tag *)",
      "Bash(npm run release *)",
      "Bash(node scripts/release.mjs *)",
      "Bash(python appstore/*)",
      "Bash(python3 appstore/*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update)",
      "Bash(npm update *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/postedit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.mjs\"",
            "timeout": 400,
            "statusMessage": "Checking docs and related tests..."
          }
        ]
      }
    ]
  }
}
